{
  "name": "Forge Funnel — lead re-engagement",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] } }, "name": "Every 6h", "type": "n8n-nodes-base.scheduleTrigger", "position": [200, 300] },
    { "parameters": { "operation": "executeQuery", "query": "select l.id, l.email, l.source_tool, l.intent, l.stack_recommendation from leads l left join clicks c on c.lead_id = l.id where c.id is null and l.created_at > now() - interval '24 hours' and not exists (select 1 from nurture_sends ns where ns.lead_id = l.id and ns.sequence_step = 'reengagement-0');" }, "name": "Find leads with no click", "type": "n8n-nodes-base.postgres", "position": [420, 300] },
    { "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.OPENAI_API_KEY}}" }] }, "sendBody": true, "bodyParameters": { "parameters": [{ "name": "model", "value": "gpt-4o-mini" }, { "name": "response_format", "value": "{\"type\":\"json_object\"}" }, { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Write a short re-engagement email. Reference the tool but never name a brand. Return JSON with subject and body.\"},{\"role\":\"user\",\"content\":\"Source tool: {{$json.source_tool}} Intent: {{JSON.stringify($json.intent)}}\"}]" }] } }, "name": "AI writes re-engagement", "type": "n8n-nodes-base.httpRequest", "position": [640, 300] },
    { "parameters": { "method": "POST", "url": "https://api.resend.com/emails", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.RESEND_API_KEY}}" }] }, "sendBody": true, "bodyParameters": { "parameters": [{ "name": "from", "value": "={{$env.FROM_EMAIL}}" }, { "name": "to", "value": "={{$('Find leads with no click').item.json.email}}" }, { "name": "subject", "value": "={{JSON.parse($json.choices[0].message.content).subject}}" }, { "name": "html", "value": "={{JSON.parse($json.choices[0].message.content).body}}" }] } }, "name": "Resend email", "type": "n8n-nodes-base.httpRequest", "position": [860, 300] },
    { "parameters": { "operation": "executeQuery", "query": "insert into nurture_sends(lead_id, sequence_step) values ('{{$('Find leads with no click').item.json.id}}', 'reengagement-0') on conflict do nothing;" }, "name": "Record send", "type": "n8n-nodes-base.postgres", "position": [1080, 300] }
  ],
  "connections": { "Every 6h": { "main": [[{ "node": "Find leads with no click", "type": "main", "index": 0 }]] }, "Find leads with no click": { "main": [[{ "node": "AI writes re-engagement", "type": "main", "index": 0 }]] }, "AI writes re-engagement": { "main": [[{ "node": "Resend email", "type": "main", "index": 0 }]] }, "Resend email": { "main": [[{ "node": "Record send", "type": "main", "index": 0 }]] } },
  "settings": { "executionOrder": "v1" }
}
