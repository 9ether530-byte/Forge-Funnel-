# Public URL without a trailing slash, for example https://ci.example.com
WOODPECKER_HOST=https://ci.example.com

# Forge integration: this template defaults to GitHub.
# For Gitea/Forgejo, replace the WOODPECKER_GITHUB_* variables with that forge's
# documented provider variables and update the compose environment accordingly.
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=replace-with-oauth-client-id
WOODPECKER_GITHUB_SECRET=replace-with-oauth-client-secret

# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=replace-with-random-agent-secret

# Keep the agent on the internal Compose gRPC address unless it is remote.
WOODPECKER_AGENT_SERVER=woodpecker-server:9000
WOODPECKER_MAX_WORKFLOWS=2
